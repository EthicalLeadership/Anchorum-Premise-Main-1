# Kimi project memory
.kimi-memory/

# Stray ImageMagick PostScript dumps named after stdlib modules.
# Something on this machine writes ~8-13 MB PostScript files to the repository
# root using stdlib module names as titles; four were committed by the initial
# scaffold (~40 MB). The writer has not been identified, so these are ignored
# by absolute root path to stop them being re-added. They never shadowed the
# stdlib (verified: json resolves to the stdlib path, sys is a builtin).
/json
/sys
/time
/uuid

# Stray relative-path tree from another project.
# A tool invoked with a path like "home/kark/Desktop/<other-project>/..." was
# run with the repository root as its working directory, so it created that
# tree *inside* this repo instead of under /home. The files belong to a
# different codebase and are not part of this project's history.
/home/

#!/usr/bin/env bash
# Pre-commit gate. Fail-aggregated across six checks:
#   1. Source integrity (scripts/check_integrity.py)
#   2. Secret scan on staged changes (gitleaks; SKIPPED-warn if not installed)
#   3. Audit freshness (scripts/check_audit_freshness.py) — warn-only here
#   4. TypeScript typecheck (tsc --noEmit) — only if .ts/.tsx staged
#   5. Frontend unit tests (vitest run) — only if .test.ts/.test.tsx staged
#   6. Python tests (pytest -q -x) — only if .py staged
#
# Integrity, secret scan and audit freshness run for every commit.
# Language-specific checks run only when the corresponding language is in
# the change set, so a doc-only or shell-only commit does not pay the pytest
# runtime.
#
# Audit freshness is deliberately non-blocking here and blocking in CI
# (.github/workflows/integrity.yml runs it with --strict). Locally the goal is
# to make drift visible at the moment it is created; the merge gate is what
# makes it stop.

set -uo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if [ -d "$REPO_ROOT/.venv/bin" ]; then
    export PATH="$REPO_ROOT/.venv/bin:$PATH"
fi

fail=0

# 1. Source integrity: zero-byte files, syntax errors, duplicated
#    declarations and content, and imports spliced into docstrings.
if ! "${PYTHON:-python3}" scripts/check_integrity.py; then
    echo "pre-commit: check_integrity.py failed" >&2
    fail=1
fi

# 2. Secret scan on staged changes. If gitleaks is not installed, warn but
#    do not fail — a missing optional tool must not block commits, but must
#    not pass silently either.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed - secret scan SKIPPED"
    echo "pre-commit: install gitleaks to enable it"
else
    # --redact keeps a detected secret out of terminal scrollback and CI logs.
    if ! gitleaks git --staged --config .gitleaks.toml --no-banner --redact; then
        echo "pre-commit: gitleaks failed" >&2
        fail=1
    fi
fi


# 4-6. Language-specific checks, only if the relevant files are staged.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
has_ts=0
has_test_ts=0
has_py=0

while IFS= read -r f; do
    case "$f" in
        *.test.ts|*.test.tsx)  has_ts=1; has_test_ts=1 ;;
        *.ts|*.tsx)            has_ts=1 ;;
        *.py)                  has_py=1 ;;
    esac
done <<EOF
$staged
EOF

if [ "$has_ts" -eq 1 ]; then
    echo "pre-commit: npx tsc --noEmit"
    if ! ( cd "$REPO_ROOT/interface" && npx tsc --noEmit ); then
        echo "pre-commit: tsc failed" >&2
        fail=1
    fi
fi

if [ "$has_test_ts" -eq 1 ]; then
    echo "pre-commit: vitest run"
    if ! ( cd "$REPO_ROOT/interface" && ./node_modules/.bin/vitest run ); then
        echo "pre-commit: vitest failed" >&2
        fail=1
    fi
fi

if [ "$has_py" -eq 1 ]; then
    echo "pre-commit: pytest -q -x"
    if ! ( cd "$REPO_ROOT" && pytest -q -x ); then
        echo "pre-commit: pytest failed" >&2
        fail=1
    fi
fi

exit $fail
